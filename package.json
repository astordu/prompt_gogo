{
  "name": "prompt-gogo",
  "version": "1.0.0",
  "description": "A desktop app for processing selected text with AI using keyboard shortcuts",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js test/run/*.test.js",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "coverage": "c8 --reporter=text --reporter=html --all --include='src/**/*.js' --reports-dir=/tmp/prompt-gogo-coverage npm test",
    "verify": "./.githooks/pre-push",
    "dist": "electron-builder --mac dmg",
    "build": "electron-builder"
  },
  "keywords": [
    "electron",
    "ai",
    "text-processing",
    "deepseek"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.promptgogo.app",
    "productName": "Prompt Go",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "identity": null
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
