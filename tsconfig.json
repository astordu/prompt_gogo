{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "src/**/*.js",
    "types/**/*.d.ts"
  ]
}
